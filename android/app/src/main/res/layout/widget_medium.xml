<?xml version="1.0" encoding="utf-8"?>
<!-- wide but short (e.g. 4x1, Fold cover screen): word + 훈음 + meaning on one line each -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp">
    <TextView android:id="@+id/w_main" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical|start" android:maxLines="1"
        android:textColor="#FFFFFF" android:textStyle="bold"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp" />
    <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1" android:textColor="#D6E4DD" android:textSize="12sp" />
</LinearLayout>
