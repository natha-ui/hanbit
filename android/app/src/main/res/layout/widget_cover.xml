<?xml version="1.0" encoding="utf-8"?>
<!-- Flip cover screen: deep indigo, the tiger down the left, magpies flying above, the word beside -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_cover_bg" android:clipToOutline="true">
    <ImageView android:layout_width="104dp" android:layout_height="52dp" android:layout_gravity="top|end"
        android:layout_marginTop="12dp" android:layout_marginEnd="8dp"
        android:src="@drawable/magpies" android:contentDescription="@null" />
    <TextView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp" android:layout_marginBottom="20dp"
        android:background="@drawable/seal_bg" android:gravity="center" android:includeFontPadding="false"
        android:fontFamily="serif" android:text="虎" android:textColor="#F7E9D2" android:textSize="14sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:paddingStart="10dp" android:paddingTop="56dp" android:paddingBottom="22dp">
        <ImageView android:id="@+id/w_icon" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1.35" android:scaleType="fitEnd"
            android:src="@drawable/tiger_cut" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="10dp" android:gravity="center_vertical" android:orientation="vertical"
            android:paddingEnd="16dp" android:paddingBottom="26dp">
            <ImageView android:layout_width="24dp" android:layout_height="5dp"
                android:src="@drawable/saekdong" android:contentDescription="@null" />
            <TextView android:id="@+id/w_tag" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:maxLines="2" android:textColor="#E2B45A" android:textSize="11.5sp" />
            <TextView android:id="@+id/w_word" android:layout_width="match_parent" android:layout_height="40dp"
                android:gravity="center_vertical|start" android:maxLines="1"
                android:textColor="#F6F0E1" android:textStyle="bold"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/w_hanja" android:layout_width="match_parent" android:layout_height="30dp"
                android:gravity="center_vertical|start" android:maxLines="1" android:fontFamily="serif"
                android:textColor="#EBCB8B"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/w_hunum" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:maxLines="3" android:ellipsize="end"
                android:textColor="#EFE8D8" android:textSize="12sp" />
            <TextView android:id="@+id/w_en" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:maxLines="3" android:ellipsize="end"
                android:textColor="#C9D3DA" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
