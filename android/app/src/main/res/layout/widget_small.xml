<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:clipToOutline="true"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="6dp" android:paddingEnd="12dp" android:paddingTop="3dp" android:paddingBottom="2dp">
    <ImageView android:id="@+id/w_icon" android:layout_width="wrap_content" android:layout_height="match_parent"
        android:maxWidth="64dp" android:adjustViewBounds="true" android:scaleType="fitEnd"
        android:src="@drawable/tiger_cut" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginStart="8dp" android:gravity="center_vertical" android:orientation="vertical"
        android:paddingTop="6dp" android:paddingBottom="6dp">
        <TextView android:id="@+id/w_word" style="@style/WidgetText"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3"
            android:maxHeight="30dp" android:gravity="bottom|start" android:maxLines="1"
            android:textColor="#F6F0E1" android:textStyle="bold"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/w_hanja" style="@style/WidgetText"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:maxHeight="24dp" android:gravity="top|start" android:maxLines="1"
            android:fontFamily="serif" android:textColor="#EBCB8B"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
</LinearLayout>
