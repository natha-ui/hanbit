<?xml version="1.0" encoding="utf-8"?>
<!-- 1-2 cells: just the word and its hanja, scaled to fit -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="8dp">
    <TextView android:id="@+id/w_main" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center" android:maxLines="1"
        android:textColor="#FFFFFF" android:textStyle="bold"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="40sp" android:autoSizeStepGranularity="1sp" />
</LinearLayout>
