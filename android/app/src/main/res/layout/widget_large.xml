<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:clipToOutline="true">
    <ImageView android:layout_width="86dp" android:layout_height="43dp" android:layout_gravity="top|end"
        android:layout_marginTop="6dp" android:layout_marginEnd="6dp"
        android:src="@drawable/magpies" android:contentDescription="@null" />
    <TextView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp" android:layout_marginBottom="16dp"
        android:background="@drawable/seal_bg" android:gravity="center" android:includeFontPadding="false"
        android:fontFamily="serif" android:text="虎" android:textColor="#F7E9D2" android:textSize="12sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:paddingStart="6dp" android:paddingTop="6dp" android:paddingBottom="4dp">
        <ImageView android:id="@+id/w_icon" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:maxWidth="124dp" android:adjustViewBounds="true" android:scaleType="fitEnd"
            android:src="@drawable/tiger_cut" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="12dp" android:orientation="vertical"
            android:paddingTop="14dp" android:paddingBottom="10dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="84dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="26dp" android:layout_height="5dp"
                    android:src="@drawable/saekdong" android:contentDescription="@null" />
                <TextView android:id="@+id/w_tag" style="@style/WidgetText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                    android:maxLines="1" android:ellipsize="end" android:textColor="#E2B45A" android:textSize="12.5sp" />
            </LinearLayout>
            <TextView android:id="@+id/w_main" style="@style/WidgetText"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:maxHeight="52dp" android:gravity="center_vertical|start" android:maxLines="1"
                android:textColor="#F6F0E1" android:textStyle="bold"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/w_hunum" style="@style/WidgetText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:textColor="#EFE8D8" android:textSize="15sp" />
            <TextView android:id="@+id/w_en" style="@style/WidgetText"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:layout_marginEnd="22dp"
                android:ellipsize="end" android:maxLines="2" android:textColor="#D5DEE4" android:textSize="13.5sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
